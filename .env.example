# Postgres (Neon via Vercel Marketplace, or any Postgres)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob (Storage tab in the Vercel project)
BLOB_READ_WRITE_TOKEN=

# Anthropic — reads screenshots and writes the Wrapped recaps
ANTHROPIC_API_KEY=
# Optional: claude-haiku-5-5 is the cheap option; defaults to claude-opus-5-5
PARSER_MODEL=claude-opus-5-5
RECAP_MODEL=claude-opus-5-5

# Resend for emails (daily reminders, Wrapped, invites)
RESEND_API_KEY=
# Must be a verified sender on Resend. onboarding@resend.dev only delivers to your own address.
EMAIL_FROM="Skint <noreply@yourdomain.com>"

# Vercel sets this automatically for cron requests; set it yourself locally to test
CRON_SECRET=

# Optional: used in emails/invite links. Falls back to the Vercel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apple Pay one-tap setup. iCloud link to the shared shortcut you built once on an iPhone
# (docs/apple-pay-shortcut.md). Leave empty and the settings page shows the manual instructions instead.
APPLE_PAY_SHORTCUT_URL=
# Must match the shortcut's name exactly; the Connect button opens it by name.
APPLE_PAY_SHORTCUT_NAME="Who Can Spend the Less?"
# "text" (default): each person's automation passes merchant/amount/card as a Text action.
# "transaction": the shared shortcut reads the Wallet transaction itself, so people only pick it.
APPLE_PAY_SHORTCUT_INPUT=text
